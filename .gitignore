# Hide all dot directories and files
/.*
# Except these git files
!/.gitignore
!/.gitattributes
!/.github/

# Agent/harness tooling
# .agents has no trailing slash on purpose: `dotagents link` makes it a symlink,
# which git treats as a file, so a directory-only `.agents/` would not ignore it.
.agents
*.local.*
CLAUDE*
.claude

# Build/dist output
build/
dist/
site/

# Python-specific patterns
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
*.egg-info/
.venv/
.pyvenv*/

# OS/editor
.idea/
.DS_Store

# Preserve
/_*
