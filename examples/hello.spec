# Generated by pkgforge dbdump -f rpmspec from pkgforge.cfg.
# An existing spec is kept: regenerate it with --force.
# Build: rpmbuild -bb --define "pkgforge_config PATH" hello.spec, PATH being pkgforge.cfg.
%{!?pkgforge_config:%{error:define pkgforge_config as the path of pkgforge.cfg: rpmbuild -bb --define "pkgforge_config PATH" hello.spec}}

# The package holds the recorded files unchanged.
%global __os_install_post %{nil}
%global debug_package %{nil}

Name:           hello
Version:        1.0
Release:        1
Summary:        pkgforge example package
License:        MIT
BuildArch:      noarch

%description
A sample package whose file list, modes and owners come from a pkgforge file
DB. The hello user comes from the sysusers.d file in the package.

%package -n hello-doc
Summary:        pkgforge example package documentation

%description -n hello-doc
The README of the pkgforge example package.

%install
export PKGFORGE_ROOT=%{buildroot} PKGFORGE_DB=%{_builddir}/pkgforge.jsonl
pkgforge -q --config "%{pkgforge_config}" stage --init
mkdir -p %{_builddir}/pkgforge-files
pkgforge -q --config "%{pkgforge_config}" dbdump -f rpmspecfiles %{_builddir}/pkgforge-files

%post
%{?systemd_post:%systemd_post hello.service}
systemd-tmpfiles --create /usr/lib/tmpfiles.d/hello.conf >/dev/null 2>&1 || :

%preun
%{?systemd_preun:%systemd_preun hello.service}

%postun
%{?systemd_postun_with_restart:%systemd_postun_with_restart hello.service}

%files -f %{_builddir}/pkgforge-files/files-hello.txt

%files -n hello-doc -f %{_builddir}/pkgforge-files/files-hello-doc.txt
