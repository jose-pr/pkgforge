#!/usr/bin/make -f
# Stages into debian/tmp from pkgforge.cfg and records the file DB. The
# dump runs after dh_prep, so the substitution variable
# ${pkgforge:Depends} in debian/control is defined. Needs pkgforge on PATH.
export PKGFORGE_ROOT := $(CURDIR)/debian/tmp
export PKGFORGE_DB := $(CURDIR)/debian/pkgforge.jsonl

%:
	dh $@

override_dh_auto_install:
	pkgforge -q --config pkgforge.cfg stage --init
	pkgforge -q --config pkgforge.cfg dbdump -f debian debian/
	dh_installdirs

override_dh_fixperms:
	dh_fixperms
	sh debian/fixperms debian
